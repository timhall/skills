{% comment %} TRMNL private-plugin markup for the daily dashboard (Full layout). Paste into the plugin's Markup editor.
Data arrives from push_daily_note.py as merge_variables: date, week_label, week_goals[], tasks[{text,description}],
stoic_text, reviews_waiting, my_prs. Every section degrades gracefully if its data is absent. Tweak freely in TRMNL's
live preview. The script splits each task on the em-dash: text is the part before, description the part after. {%
endcomment %} {%- capture svg_logo -%}
<svg
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="black"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <rect x="4" y="3" width="16" height="18" rx="2" />
  <path d="M8 8h8M8 12h8M8 16h5" />
</svg>
{%- endcapture -%}

<div class="layout layout--col layout--stretch gap--xlarge">
  {% comment %} Top band: Today, full width {% endcomment %}
  <div class="flex flex--col flex--left">
    <div>
      <span class="title title--large">Today</span>
      <span class="description description--large"
        >{% if reviews_waiting %}{{ reviews_waiting }} reviews &middot; {{ my_prs }} PRs{% endif %}</span
      >
    </div>
    <div class="flex flex--col gap--large">
      {% for task in tasks %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="title">{{ task.text }}</span>
          {% if task.description != blank %}<span class="description">{{ task.description }}</span>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>

  {% comment %} Bottom band: this week + stoic quote, split {% endcomment %}
  <div class="columns">
    <div class="column">
      <span class="label label--underline">This Week &middot; {{ week_label }}</span>
      {% if week_goals and week_goals.size > 0 %} {% for goal in week_goals %}
      <div class="item">
        <div class="content"><span class="description description--small">&#9679; {{ goal }}</span></div>
      </div>
      {% endfor %} {% else %}
      <span class="description">No weekly goals set</span>
      {% endif %}
    </div>
    {% if stoic_text %}
    <div class="column">
      <span class="label label--underline">Daily Stoic</span>
      <div class="content">{{ stoic_text }}</div>
    </div>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <img class="image image-stroke" src="data:image/svg+xml;base64,{{ svg_logo | base64_encode }}" />
  <span class="title">Daily Note</span>
  <span class="instance">{{ date }}</span>
</div>
