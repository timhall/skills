#!/usr/bin/env python3
"""track — list and query personal issues and missions from the notes vault.

The markdown files are the source of truth; this only reads them.
  $NOTES_VAULT (default ~/Documents/notes)
    Issues/NNNN-slug.md     Missions/NNNN-slug.md
Each file opens with flat YAML-ish frontmatter (scalars + inline [lists]) between
--- fences. Block-style YAML (nested maps, multi-line lists) is not supported —
the tracker frontmatter never uses it.

Usage:
  track list [-q key=val[,val2] ...] [--json]
  track get  <issue|mission> <id> [--json]
  track path <issue|mission> <id>
  track new  issue|mission "<title>" [--slug S] [--source S] [--link [Label|]URL] ...
  track set  <issue|mission> <id> key=value ...

Filters (repeatable -q; AND across keys, comma = OR within one key):
  -q type=issue                 issue | mission            (default: both)
  -q status=open,investigating  match any listed status
  -q stale=2                    >= N days since last_triaged (else file mtime)
  -q <frontmatter-key>=...      any field, e.g. source=slack, tags=infra
String matches are case-insensitive. A list-valued field (e.g. tags) matches if
any of its entries is listed.

new/set own the on-disk format so it never drifts: new assigns the next integer
id, the zero-padded filename, and the per-type frontmatter + body scaffold; set
edits frontmatter fields in place (e.g. status, last_triaged) without disturbing
the rest of the file. Judgment (title, slug, description) is passed in by caller.
"""

import argparse
import datetime as dt
import glob
import json
import os
import re
import sys
import urllib.parse

VAULT = os.path.expanduser(os.environ.get("NOTES_VAULT") or "~/Documents/notes")
SUBDIR = {"issue": "Issues", "mission": "Missions"}


def parse_value(raw):
    """One frontmatter value -> None | str | list[str]. Flat scalars only."""
    v = raw.strip()
    if v == "":
        return None
    if v.startswith("[") and v.endswith("]"):
        inner = v[1:-1].strip()
        if not inner:
            return []
        return [p.strip().strip('"').strip("'") for p in inner.split(",") if p.strip()]
    if len(v) >= 2 and v[0] in "\"'" and v[-1] == v[0]:
        return v[1:-1]
    return v


def split_frontmatter(text):
    """(frontmatter dict, body after the closing fence). {} + full text if absent."""
    lines = text.splitlines(keepends=True)
    if not lines or lines[0].strip() != "---":
        return {}, text
    fm = {}
    for i, line in enumerate(lines[1:], start=1):
        if line.strip() == "---":
            return fm, "".join(lines[i + 1:]).lstrip("\n")
        key, _, val = line.partition(":")  # first colon; URLs keep their scheme
        if _:
            fm[key.strip()] = parse_value(val)
    return fm, ""  # unterminated fence: treat all of it as frontmatter


def parse_frontmatter(text):
    return split_frontmatter(text)[0]


def load_items(only_type=None):
    items = []
    types = [only_type] if only_type else SUBDIR
    for typ in types:
        pattern = os.path.join(VAULT, SUBDIR[typ], "*.md")
        for path in sorted(glob.glob(pattern)):
            try:
                with open(path) as fh:
                    fm = parse_frontmatter(fh.read())
            except OSError:
                continue
            raw_id = fm.get("id")
            try:
                item_id = int(raw_id)
            except (TypeError, ValueError):
                item_id = None
            items.append({
                "type": typ,
                "id": item_id,
                "status": fm.get("status") or "",
                "title": fm.get("title") or os.path.basename(path),
                "path": path,
                "stale_days": stale_days(fm, path),
                "frontmatter": fm,
            })
    items.sort(key=lambda it: (it["type"], it["id"] if it["id"] is not None else 1 << 30))
    return items


def stale_days(fm, path):
    """Days since last_triaged (frontmatter) or, failing that, file mtime."""
    lt = fm.get("last_triaged")
    ref = None
    if isinstance(lt, str):
        try:
            ref = dt.datetime.strptime(lt.strip(), "%Y-%m-%d").date()
        except ValueError:
            ref = None
    if ref is None:
        try:
            ref = dt.date.fromtimestamp(os.path.getmtime(path))
        except OSError:
            return None
    return (dt.date.today() - ref).days


def parse_filters(query_args):
    """['status=a,b', 'stale=2'] -> {'status': {'a','b'}, 'stale': {'2'}}."""
    filters = {}
    for q in query_args or []:
        if "=" not in q:
            sys.exit(f"track: bad filter {q!r} — expected key=value")
        key, _, val = q.partition("=")
        key = key.strip().lower()
        vals = {p.strip() for p in val.split(",") if p.strip()}
        filters.setdefault(key, set()).update(vals)
    return filters


def matches(item, filters):
    for key, wanted in filters.items():
        if key == "type":
            if item["type"] not in {w.lower() for w in wanted}:
                return False
        elif key == "stale":
            try:
                threshold = min(int(w) for w in wanted)
            except ValueError:
                sys.exit("track: stale filter needs an integer, e.g. stale=2")
            if item["stale_days"] is None or item["stale_days"] < threshold:
                return False
        else:
            field = item["frontmatter"].get(key)
            if field is None:
                return False
            have = {str(v).lower() for v in (field if isinstance(field, list) else [field])}
            if not (have & {w.lower() for w in wanted}):
                return False
    return True


def cmd_list(args):
    filters = parse_filters(args.query)
    only = None
    if filters.get("type") and len(filters["type"]) == 1:
        only = next(iter(filters["type"])).lower()
        if only not in SUBDIR:
            sys.exit(f"track: unknown type {only!r} — use issue or mission")
    items = [it for it in load_items(only) if matches(it, filters)]

    if args.json:
        print(json.dumps([{k: it[k] for k in
                           ("type", "id", "status", "title", "path", "stale_days")}
                          for it in items], indent=2))
        return
    if not items:
        print("no matching items")
        return
    width = max(len(it["title"]) for it in items)
    width = min(width, 60)
    for it in items:
        title = it["title"] if len(it["title"]) <= 60 else it["title"][:57] + "…"
        stale = f"{it['stale_days']}d" if it["stale_days"] is not None else "-"
        idcol = "-" if it["id"] is None else it["id"]
        print(f"{it['type']:<7} {idcol:>4}  {it['status']:<13} {stale:>4}  {title:<{width}}")


def resolve(type_arg, id_arg):
    typ = type_arg.lower()
    if typ not in SUBDIR:
        sys.exit(f"track: unknown type {type_arg!r} — use issue or mission")
    try:
        want = int(id_arg)
    except ValueError:
        sys.exit(f"track: id must be an integer, got {id_arg!r}")
    for it in load_items(typ):
        if it["id"] == want:
            return it
    sys.exit(f"track: no {typ} with id {want}")


def cmd_get(args):
    it = resolve(args.type, args.id)
    if args.json:
        with open(it["path"]) as fh:
            _, body = split_frontmatter(fh.read())
        print(json.dumps({**{k: it[k] for k in
                             ("type", "id", "status", "title", "path", "stale_days")},
                          "frontmatter": it["frontmatter"], "body": body}, indent=2))
    else:
        with open(it["path"]) as fh:
            sys.stdout.write(fh.read())


def cmd_path(args):
    print(resolve(args.type, args.id)["path"])


def slugify(text):
    s = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    if len(s) > 60:
        s = s[:60].rsplit("-", 1)[0]
    return s or "untitled"


def next_id(typ):
    ids = [it["id"] for it in load_items(typ) if it["id"] is not None]
    return max(ids) + 1 if ids else 1


def format_link(spec):
    """'Label|url' or bare 'url' -> '- [Label](url)'; label defaults to the host."""
    if "|" in spec:
        label, url = (p.strip() for p in spec.split("|", 1))
    else:
        url = spec.strip()
        label = urllib.parse.urlparse(url).netloc.replace("www.", "") or "link"
    return f"- [{label}]({url})"


def format_fm_line(key, val):
    """A frontmatter line, quoting only when bare YAML would misread the value."""
    if val == "":
        return f"{key}:"
    needs_quote = (val != val.strip() or ": " in val or " #" in val
                   or val[:1] in "[]{}#&*!|>'\"%@`,")
    if needs_quote:
        return f'{key}: "{val.replace(chr(92), chr(92) * 2).replace(chr(34), chr(92) + chr(34))}"'
    return f"{key}: {val}"


def cmd_new(args):
    typ, title = args.type, args.title.strip()
    slug = (args.slug or slugify(title)).strip("-") or slugify(title)
    new_id = next_id(typ)
    created = dt.date.today().isoformat()
    links = [format_link(l) for l in (args.link or [])]

    if typ == "issue":
        fm = [f"id: {new_id}", f'title: "{title}"', "status: open",
              f"source: {args.source or 'self'}", f"created: {created}",
              "closed:", "pr:", "jira:", "tags: []"]
        sections = [("## Description", (args.description or "").strip()),
                    ("## Investigation", ""), ("## Resolution", "")]
    else:
        fm = [f"id: {new_id}", f'title: "{title}"', "status: idea",
              f"created: {created}", "plans:", "jira:", "tags: []"]
        sections = [("## Problem", (args.problem or "").strip()),
                    ("## Goal", (args.goal or "").strip()),
                    ("## Progress", ""), ("## Resolution", "")]

    out = ["---", *fm, "---", f"# {title}", ""]
    if links:
        out += links + [""]
    for i, (heading, content) in enumerate(sections):
        out += [heading, ""]
        if content:
            out += [content, ""]
        elif i < len(sections) - 1:
            out.append("")  # spacer so empty sections don't collide
    text = "\n".join(out).rstrip() + "\n"

    path = os.path.join(VAULT, SUBDIR[typ], f"{new_id:04d}-{slug}.md")
    if os.path.exists(path):
        sys.exit(f"track: refusing to overwrite existing {path}")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as fh:
        fh.write(text)
    if args.json:
        print(json.dumps({"type": typ, "id": new_id, "path": path}))
    else:
        print(f"created {typ} {new_id}: {path}")


def cmd_set(args):
    it = resolve(args.type, args.id)
    path = it["path"]
    with open(path) as fh:
        lines = fh.read().split("\n")
    if not lines or lines[0].strip() != "---":
        sys.exit(f"track: {path} has no frontmatter to edit")
    try:
        end = next(i for i in range(1, len(lines)) if lines[i].strip() == "---")
    except StopIteration:
        sys.exit(f"track: {path} frontmatter is not terminated")

    assignments = {}
    for a in args.assignments:
        if "=" not in a:
            sys.exit(f"track: bad assignment {a!r} — expected key=value")
        key, _, val = a.partition("=")
        assignments[key.strip()] = val.strip()

    for key, val in assignments.items():
        idx = next((i for i in range(1, end)
                    if lines[i].split(":", 1)[0].strip() == key), None)
        if idx is not None:
            lines[idx] = format_fm_line(key, val)
        else:
            lines.insert(end, format_fm_line(key, val))
            end += 1

    with open(path, "w") as fh:
        fh.write("\n".join(lines))
    changed = ", ".join(f"{k}={v or '∅'}" for k, v in assignments.items())
    print(f"updated {args.type} {it['id']}: {changed}")


def main():
    ap = argparse.ArgumentParser(prog="track", description="Query issues and missions.")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p_list = sub.add_parser("list", help="list items, optionally filtered")
    p_list.add_argument("-q", "--query", action="append", metavar="key=val",
                        help="filter (repeatable); comma = OR within a key")
    p_list.add_argument("--json", action="store_true", help="emit JSON")
    p_list.set_defaults(func=cmd_list)

    p_get = sub.add_parser("get", help="print one item's file")
    p_get.add_argument("type")
    p_get.add_argument("id")
    p_get.add_argument("--json", action="store_true", help="emit JSON (frontmatter+body)")
    p_get.set_defaults(func=cmd_get)

    p_path = sub.add_parser("path", help="print one item's file path")
    p_path.add_argument("type")
    p_path.add_argument("id")
    p_path.set_defaults(func=cmd_path)

    p_new = sub.add_parser("new", help="create an issue or mission")
    p_new.add_argument("type", choices=("issue", "mission"))
    p_new.add_argument("title")
    p_new.add_argument("--slug", help="filename slug (default: slugified title)")
    p_new.add_argument("--source", help="issue source (default: self)")
    p_new.add_argument("--link", action="append", metavar="[Label|]URL",
                       help="link under the title (repeatable)")
    p_new.add_argument("--description", help="issue: Description body")
    p_new.add_argument("--problem", help="mission: Problem body")
    p_new.add_argument("--goal", help="mission: Goal body")
    p_new.add_argument("--json", action="store_true", help="emit {type,id,path}")
    p_new.set_defaults(func=cmd_new)

    p_set = sub.add_parser("set", help="update frontmatter fields in place")
    p_set.add_argument("type", choices=("issue", "mission"))
    p_set.add_argument("id")
    p_set.add_argument("assignments", nargs="+", metavar="key=value")
    p_set.set_defaults(func=cmd_set)

    args = ap.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
